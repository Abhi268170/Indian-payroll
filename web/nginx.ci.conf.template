events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # Upstream host/port injected at container start (envsubst). Targets the API Service.
    upstream api {
        server ${API_HOST}:${API_PORT};
    }

    server {
        listen 80;
        root /usr/share/nginx/html;
        index index.html;

        # API + OpenIddict + health — proxied same-origin to the API Service.
        location /api/ {
            proxy_pass http://api/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Tenant provisioning runs schema migrations and can exceed the
            # 60s default; without this nginx returns 504 and aborts the API.
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location /connect/ {
            proxy_pass http://api/connect/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location /health {
            proxy_pass http://api/health;
        }

        # SPA fallback
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
