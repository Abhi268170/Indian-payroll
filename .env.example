# =============================================================================
# PLHB deployment variable contract (Azure DevOps variable groups).
# Tokens use the replacetokens "rm" pattern: #{VAR}#  (resolved at pipeline time).
# These same keys must exist in the K8s deploy variable group(s) below — the
# CI-CD/K8s-*.yml manifests reference them as $(VAR) at apply time.
# Secrets (passwords, keys) must be marked secret in the variable group.
# See CI-CD/README.md for the full deploy guide.
# =============================================================================

# ---- Image / placement (per variable group: PLHB-Api-DEV, PLHB-Web-DEV) ------
dockerrepo=#{dockerrepo}#            # e.g. plhb-api  /  plhb-web
namespace=#{namespace}#              # k8s namespace (reuse the existing payroll namespace)
proj_branch=#{proj_branch}#          # base app name, e.g. payroll-dev (web Service = this)
site_url=#{site_url}#                # public host, e.g. payroll.dev.displayme.net
STORAGE_CLASS=#{STORAGE_CLASS}#      # RWX-capable StorageClass (api only), e.g. azurefile
API_HOST=#{API_HOST}#                # WEB group only: API Service name = the API group's "<proj_branch>-api"

# ---- PostgreSQL (existing Postgres-17) --------------------------------------
POSTGRES_HOST=#{POSTGRES_HOST}#
POSTGRES_PORT=#{POSTGRES_PORT}#
POSTGRES_DB_DOTNET=#{POSTGRES_DB_DOTNET}#          # single DB; app is schema-per-tenant (public + tenant schemas)
POSTGRES_DB_HANGFIRE=#{POSTGRES_DB_HANGFIRE}#
POSTGRES_USER=#{POSTGRES_USER}#
POSTGRES_PASSWORD=#{POSTGRES_PASSWORD}#

# ---- Redis (existing) -------------------------------------------------------
REDIS_HOST=#{REDIS_HOST}#
REDIS_PORT=#{REDIS_PORT}#
REDIS_PASSWORD=#{REDIS_PASSWORD}#

# ---- App secrets ------------------------------------------------------------
ENCRYPTION_KEY=#{ENCRYPTION_KEY}#            # AES-256 key for PAN/Aadhaar/bank at rest
SUPERADMIN_EMAIL=#{SUPERADMIN_EMAIL}#        # seeded platform superadmin (API only)
SUPERADMIN_PASSWORD=#{SUPERADMIN_PASSWORD}#  # min 12 chars
OPENIDDICT_CLIENT_SECRET=#{OPENIDDICT_CLIENT_SECRET}#  # OpenIddict SPA client secret (API only)

# ---- Email / SMTP -----------------------------------------------------------
SMTP_HOST=#{SMTP_HOST}#
SMTP_PORT=#{SMTP_PORT}#
SMTP_USERNAME=#{SMTP_USERNAME}#
SMTP_PASSWORD=#{SMTP_PASSWORD}#
SMTP_FROM=#{SMTP_FROM}#
SMTP_USE_SSL=#{SMTP_USE_SSL}#                # false when using STARTTLS on 587
SMTP_USE_STARTTLS=#{SMTP_USE_STARTTLS}#      # true for port 587
